# ==============================================================================
# Twitch Extension Backend Service (EBS) - Environment Configuration
# Copy this file to .env in the Server directory or project root:
#   cp env.example .env
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# SSL / HTTPS Configuration
# Set to 'true' to run HTTPS with automatic self-signed SSL certs via node-forge (default for Twitch)
# Set to 'false' to run standard HTTP (e.g. for testing behind ngrok or local reverse proxies)
USE_SSL=true

# Twitch Extension Panel Dimensions (Twitch specification allows 100px to 500px height)
# Default height applied to all panels (100 - 500)
PANEL_HEIGHT=500

# Individual panel height overrides (100 - 500)
PANEL1_HEIGHT=500
PANEL2_HEIGHT=500

# Twitch Extension Credentials (From Twitch Developer Console -> Extension -> Settings)
# https://dev.twitch.tv/console/extensions
TWITCH_EXTENSION_CLIENT_ID=your_twitch_extension_client_id_here
TWITCH_EXTENSION_SECRET=your_base64_extension_secret_here
TWITCH_OWNER_ID=your_twitch_broadcaster_user_id_here

# Optional Custom SSL Certificate Paths (If omitted and USE_SSL=true, node-forge generates them automatically in Server/ssl/)
# SSL_KEY_PATH=./ssl/server.key
# SSL_CERT_PATH=./ssl/server.cert

# Optional Twitch API Endpoints
TWITCH_HELIX_API_URL=https://api.twitch.tv/helix
